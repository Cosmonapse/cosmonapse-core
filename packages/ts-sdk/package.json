{
  "name": "@cosmonapse/sdk",
  "version": "0.0.0",
  "description": "Event-driven Agent-to-Agent protocol SDK  -  TypeScript surface of the Cosmonapse envelope spec",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "agents",
    "a2a",
    "protocol",
    "multi-agent",
    "cosmonapse"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "ulid": "^2.3.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "kafkajs": "^2.2.4",
    "nats": "^2.28.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "nats": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cosmonapse/cosmonapse-core"
  },
  "publishConfig": {
    "access": "public"
  }
}
