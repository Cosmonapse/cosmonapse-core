{
  "name": "@cosmonapse/sdk",
  "version": "0.0.1",
  "description": "Event-driven Agent-to-Agent protocol SDK — TypeScript surface of the Cosmonapse envelope spec",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "agents",
    "a2a",
    "protocol",
    "multi-agent",
    "cosmonapse"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @modelcontextprotocol/sdk",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "ulid": "^2.3.0"
  },
  "optionalDependencies": {
    "nats": "^2.28.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "nats": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
