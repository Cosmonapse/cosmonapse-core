{
  "name": "@cosmonapse/prism-ui",
  "version": "0.1.7",
  "private": true,
  "description": "Prism  -  browser visualization for a Cosmonapse Synapse. Built with Vite + React + TS; the static build is bundled into the cosmonapse Python wheel and served by `cosmo prism`.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:into-wheel": "npm run build && node scripts/copy-dist.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
